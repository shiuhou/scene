<?xml version="1.0" ?>
<!-- RMUC 2027 static battlefield; metres, Z-up, origin at field centre. -->
<sdf version="1.6">
  <model name="rmuc2027_sentry_field">
    <static>true</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>
    <link name="field">
      <pose>0 0 0 0 0 0</pose>
      <visual name="field_visual">
        <geometry><mesh><uri>model://rmuc2027_sentry_field/meshes/field_visual.obj</uri><scale>1 1 1</scale></mesh></geometry>
        <cast_shadows>true</cast_shadows>
      </visual>
      <collision name="field_collision">
        <geometry><mesh><uri>model://rmuc2027_sentry_field/meshes/field_collision.obj</uri><scale>1 1 1</scale></mesh></geometry>
        <surface>
          <contact><ode><collide_bitmask>0xffff</collide_bitmask><kp>1e6</kp><kd>1e3</kd></ode></contact>
          <friction><ode><mu>0.80</mu><mu2>0.75</mu2><slip1>0.01</slip1><slip2>0.01</slip2></ode></friction>
          <bounce><restitution_coefficient>0.0</restitution_coefficient></bounce>
        </surface>
      </collision>
      <!-- Optional sensor for a quick static-world smoke test. For a moving robot,
           prefer examples/sentry_lidar_demo.sdf and attach the sensor to robot TF. -->
      <sensor name="sentry_lidar" type="ray">
        <pose>0 0 0.30 0 0 0</pose>
        <always_on>true</always_on><visualize>true</visualize><update_rate>15</update_rate>
        <topic>sentry_lidar/scan</topic>
        <ray>
          <scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan>
          <range><min>0.12</min><max>30.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </ray>
      </sensor>
    </link>
  </model>
</sdf>
